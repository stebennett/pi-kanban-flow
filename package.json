{
  "name": "pi-kanban-flow",
  "version": "0.0.0",
  "description": "A Pi-native, deterministic kanban workflow package.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi",
    "kanban",
    "workflow"
  ],
  "files": [
    "extensions/",
    "skills/",
    "agents/",
    "templates/",
    "docs/",
    "README.md",
    "AGENTS.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/kanban-flow"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx",
    "build": "tsc --noEmit",
    "package": "npm pack --dry-run",
    "package:check": "node --import tsx test/unit/package-boundary.test.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
